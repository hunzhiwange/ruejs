{
  "name": "@rue-js/server-renderer",
  "version": "0.9.11",
  "description": "Server renderer for Rue SSR and static generation.",
  "keywords": [
    "rue",
    "server-renderer",
    "ssr"
  ],
  "homepage": "https://github.com/hunzhiwange/ruejs/tree/main/packages/server-renderer#readme",
  "bugs": {
    "url": "https://github.com/hunzhiwange/ruejs/issues"
  },
  "license": "MIT",
  "author": "Xiangmin Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunzhiwange/ruejs.git",
    "directory": "packages/server-renderer"
  },
  "files": [
    "index.js",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "module": "dist/server-renderer.esm-bundler.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "development": "./src/index.ts",
      "module": "./dist/server-renderer.esm-bundler.js",
      "import": "./dist/server-renderer.esm-bundler.js"
    },
    "./island": {
      "types": "./src/island.ts",
      "development": "./src/island.ts",
      "module": "./dist/server-renderer.island.esm-bundler.js",
      "import": "./dist/server-renderer.island.esm-bundler.js"
    },
    "./server-island": {
      "types": "./src/server-island.ts",
      "development": "./src/server-island.ts",
      "module": "./dist/server-renderer.server-island.esm-bundler.js",
      "import": "./dist/server-renderer.server-island.esm-bundler.js"
    },
    "./static": {
      "types": "./src/static.d.ts",
      "development": "./src/static.mjs",
      "module": "./dist/server-renderer.static.esm-bundler.js",
      "import": "./dist/server-renderer.static.esm-bundler.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "build": "pnpm -w exec node scripts/build.js '^server-renderer$'",
    "dev": "pnpm -w exec node scripts/dev.js server-renderer -f esm-bundler",
    "test": "pnpm -w exec vitest packages/server-renderer/__tests__",
    "test-unit": "pnpm -w exec vitest run packages/server-renderer"
  },
  "dependencies": {
    "@rue-js/runtime": "workspace:*"
  },
  "peerDependencies": {
    "jsdom": "^29.1.1"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "buildOptions": {
    "name": "RueServerRenderer",
    "formats": [
      "esm-bundler"
    ],
    "subEntries": [
      {
        "entry": "src/island.ts",
        "filename": "server-renderer.island",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/server-island.ts",
        "filename": "server-renderer.server-island",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/static.mjs",
        "filename": "server-renderer.static",
        "formats": [
          "esm-bundler"
        ]
      }
    ]
  }
}
