      "import": "./dist/utils/query.js"
    }
  },
  "scripts": {
    "build": "vp pack && node ../../scripts/ensure-text-bin-executable.js",
    "check": "vp pack --no-write --no-clean",
    "prepack": "vp run build",
    "dev": "vp pack --watch",
    "test": "node ../../scripts/ensure-text-test-dependencies.js && pnpm run build && vp test run --environment jsdom --teardownTimeout 60000 --maxWorkers 4 --exclude \"__tests__/e2e/**\"",
    "test-unit": "node ../../scripts/ensure-text-test-dependencies.js && pnpm run build && node ../../scripts/run-text-unit-tests.mjs"
  },
  "dependencies": {
    "@rue-js/rsc": "workspace:*",
    "@rue-js/rue": "workspace:*",
    "@rue-js/runtime": "workspace:*",
    "@rue-js/server-renderer": "workspace:*",
    "@rue-js/shared": "workspace:*",
    "@rue-js/vite-plugin-rue": "workspace:*",
    "@vercel/og": "catalog:",
    "image-size": "catalog:",
    "ipaddr.js": "catalog:",
    "jiti": "catalog:",
    "magic-string": "catalog:",
    "parse5": "^8.0.1",
    "vite-plugin-commonjs": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "web-vitals": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "kysely": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@mdx-js/rollup": "^3.0.0",
    "@rue-js/rue": "^0.3.10",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@mdx-js/rollup": {
      "optional": true
    },
    "@rue-js/rue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "buildOptions": {
    "name": "RueText",
    "formats": [
      "esm-bundler"
    ],
    "preserveModules": true,
    "external": [
      "@rue-js/rsc",
      "@rue-js/server-renderer",
      "@rue-js/text",
      "private-text-instrumentation-client",
      "text",
      "virtual:text-rsc",
      "virtual:text-rsc-entry",
      "virtual:text-server-entry"
    ],
    "rueTransform": true
  }
}
